# Supabase DashboardのProject URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable keyまたはlegacy anon key。service_role keyは設定しない。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# お問い合わせ保存専用。サーバーだけで使用し、NEXT_PUBLIC_を付けない。
SUPABASE_SERVICE_ROLE_KEY=

# WorkOS AuthKit。APIキーとCookie passwordはサーバー専用で、NEXT_PUBLIC_を付けない。
# Cookie passwordは32文字以上のランダムな値を設定する。
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:3008/auth/callback
