# Supabase DashboardのProject URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable keyまたはlegacy anon key。Secret keyは設定しない。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# お問い合わせ保存専用のsb_secret_形式。サーバーだけで使用し、NEXT_PUBLIC_を付けない。
SUPABASE_SECRET_KEY=

# WorkOS AuthKit。APIキーとCookie passwordはサーバー専用で、NEXT_PUBLIC_を付けない。
# Cookie passwordは32文字以上のランダムな値を設定する。
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:3008/auth/callback

# 公開切替などでAPI書き込みを一時停止するときだけ1にする。通常は未設定にする。
NOMILOG_WRITE_MAINTENANCE=
