-- 公開切替専用テンプレート。supabase/migrationsには置かないこと。
-- これは仮レビューを実在商品の評価として残さないための一度限りの運用SQLである。
-- docs/public-launch-runbook.mdに従い、外部バックアップと商品画像の本番配信を確認してから実行する。

begin;

set local lock_timeout = '5s';
set local statement_timeout = '30s';

-- 実行時はREPLACE_WITH_CONFIRMATIONだけを指定の確認語へ置き換える。
-- テンプレートのまま誤って「Run」を押しても、以降の削除へ進まないための手動ゲートである。
select set_config(
  'nomilog.public_launch_confirmation',
  'REPLACE_WITH_CONFIRMATION',
  true
);

do $$
begin
  if current_setting('nomilog.public_launch_confirmation', true) <> 'PUBLIC_LAUNCH_2026_BACKUP_CONFIRMED' then
    raise exception '公開切替を中止しました。バックアップ確認語が一致しません。';
  end if;
end;
$$;

-- バックアップ作成から削除・商品登録までの間にレビューやお気に入りが増えないよう、
-- 関連テーブルの書き込みを同一トランザクションの終了まで止める。SELECTは継続できる。
lock table
  public.products,
  public.profiles,
  public.app_admins,
  public.reviews,
  public.review_likes,
  public.review_reports,
  public.notifications,
  public.notification_preferences,
  public.contact_inquiries,
  public.product_requests,
  public.product_favorites
in share row exclusive mode;

do $$
declare
  dummy_product_ids uuid[] := array[
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa2',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa3',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa4',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa5',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa6',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0007',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0008',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0009',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0010',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0011',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0012',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0013',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0014',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0015',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0016',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0017',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0018',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0019',
    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaa0020'
  ]::uuid[];
  launch_product_ids uuid[] := array[
    'b0000000-0000-4000-8000-000000000001',
    'b0000000-0000-4000-8000-000000000002',
    'b0000000-0000-4000-8000-000000000003',
    'b0000000-0000-4000-8000-000000000004',
    'b0000000-0000-4000-8000-000000000005',
    'b0000000-0000-4000-8000-000000000006',
    'b0000000-0000-4000-8000-000000000007',
    'b0000000-0000-4000-8000-000000000008',
    'b0000000-0000-4000-8000-000000000009',
    'b0000000-0000-4000-8000-000000000010'
  ]::uuid[];
begin
  if to_regclass('private.public_launch_2026_products') is not null then
    raise exception '公開切替のDB内バックアップが既に存在します。再実行せず状態を確認してください。';
  end if;

  if (select count(*) from public.products) <> 20
     or (select count(*) from public.products where id = any(dummy_product_ids)) <> 20 then
    raise exception '商品マスタが想定した仮商品20件だけではないため、公開切替を中止しました。';
  end if;

  if exists (select 1 from public.products where id = any(launch_product_ids)) then
    raise exception '公開用の商品IDが既に存在するため、公開切替を中止しました。';
  end if;

  if (
    select count(*)
    from public.categories
    where id = any(array[
      '11111111-1111-4111-8111-111111111111',
      '22222222-2222-4222-8222-222222222222',
      '33333333-3333-4333-8333-333333333333',
      '66666666-6666-4666-8666-666666666666'
    ]::uuid[])
  ) <> 4 then
    raise exception '公開商品に必要なカテゴリが揃っていません。';
  end if;

  if (select count(*) from public.product_requests) <> 0 then
    raise exception '停止中の商品追加リクエストが残っているため、公開切替を中止しました。';
  end if;

  -- バックアップ前に別テンプレートで権限とStorageポリシーを停止していることをDB側でも検証する。
  -- Vercelのメンテナンス表示だけでは、既存JWTを使ったSupabase直接操作までは防げない。
  if has_table_privilege('authenticated', 'public.profiles', 'INSERT, UPDATE, DELETE, TRUNCATE')
     or has_table_privilege('authenticated', 'public.app_admins', 'INSERT, UPDATE, DELETE, TRUNCATE')
     or has_table_privilege('authenticated', 'public.reviews', 'INSERT, UPDATE, DELETE, TRUNCATE')
     or has_table_privilege('authenticated', 'public.review_likes', 'INSERT, UPDATE, DELETE, TRUNCATE')
     or has_table_privilege('authenticated', 'public.review_reports', 'INSERT, UPDATE, DELETE, TRUNCATE')
     or has_table_privilege('authenticated', 'public.notifications', 'INSERT, UPDATE, DELETE, TRUNCATE')
     or has_column_privilege('authenticated', 'public.notifications', 'read_at', 'UPDATE')
     or has_table_privilege('authenticated', 'public.notification_preferences', 'INSERT, UPDATE, DELETE, TRUNCATE')
     or has_table_privilege('authenticated', 'public.product_favorites', 'INSERT, UPDATE, DELETE, TRUNCATE')
     or has_table_privilege('authenticated', 'public.product_requests', 'INSERT, UPDATE, DELETE, TRUNCATE')
     or has_table_privilege('authenticated', 'public.contact_inquiries', 'INSERT, UPDATE, DELETE, TRUNCATE') then
    raise exception '書き込み停止が完了していないため、公開切替を中止しました。';
  end if;

  if exists (
    select 1
    from pg_policies
    where schemaname = 'storage'
      and tablename = 'objects'
      and cmd in ('INSERT', 'UPDATE', 'DELETE', 'ALL')
      and (
        position('review-images' in coalesce(qual, '') || ' ' || coalesce(with_check, '')) > 0
        or position('profile-images' in coalesce(qual, '') || ' ' || coalesce(with_check, '')) > 0
      )
  ) then
    raise exception '画像の書き込み停止が完了していません。';
  end if;

  -- Storageの実体はSQLで削除しない。バックアップ後にStorage APIまたはDashboardで削除し、
  -- ここでは残存ファイルがないことだけを確認する。
  if exists (select 1 from storage.objects where bucket_id = 'review-images') then
    raise exception 'review-imagesにファイルが残っているため、公開切替を中止しました。';
  end if;
end;
$$;

-- 外部バックアップに加え、ロック取得後の正確な状態をprivate schemaへ保存する。
-- 公開Data APIから参照できない領域に置くことで、復元性を確保しながら個人データを露出させない。
create table private.public_launch_2026_products as table public.products;
create table private.public_launch_2026_app_admins as table public.app_admins;
create table private.public_launch_2026_reviews as table public.reviews;
create table private.public_launch_2026_review_likes as table public.review_likes;
create table private.public_launch_2026_review_reports as table public.review_reports;
create table private.public_launch_2026_notifications as table public.notifications;
create table private.public_launch_2026_notification_preferences as table public.notification_preferences;
create table private.public_launch_2026_contact_inquiries as table public.contact_inquiries;
create table private.public_launch_2026_product_requests as table public.product_requests;
create table private.public_launch_2026_product_favorites as table public.product_favorites;
create table private.public_launch_2026_demo_profiles as
  select * from public.profiles where user_id like 'demo-reviewer-%';

revoke all on table
  private.public_launch_2026_products,
  private.public_launch_2026_app_admins,
  private.public_launch_2026_reviews,
  private.public_launch_2026_review_likes,
  private.public_launch_2026_review_reports,
  private.public_launch_2026_notifications,
  private.public_launch_2026_notification_preferences,
  private.public_launch_2026_contact_inquiries,
  private.public_launch_2026_product_requests,
  private.public_launch_2026_product_favorites,
  private.public_launch_2026_demo_profiles
from public, anon, authenticated;

